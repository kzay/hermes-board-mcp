FROM node:20-slim AS builder

WORKDIR /app
COPY server/package.json server/package-lock.json* server/tsconfig.json ./
RUN npm ci

COPY server/src/ src/
COPY server/policy.yaml ./
RUN npm run build

FROM node:20-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates git bash && rm -rf /var/lib/apt/lists/*

# Install openspec CLI
ENV PATH="/root/.local/bin:$PATH"
RUN npm install -g @fission-ai/openspec@1.3.1

# Install hermes CLI via official install script
# The hermes CLI is required for kanban operations.
# Using install script from https://hermes-agent.nousresearch.com/docs/
RUN curl -fsSL https://raw.githubusercontent.com/NousResearch/hermes-agent/main/scripts/install.sh | bash \
  && hermes --version

COPY server/package.json server/package-lock.json* ./
RUN npm ci --omit=dev 2>/dev/null || npm install --omit=dev

COPY --from=builder /app/dist /app/dist
COPY server/policy.yaml ./policy.yaml

# Seed E2E project metadata for hb_import_spec routing
RUN mkdir -p /opt/hermes/projects/e2e-test && \
  printf '%s\n' \
    'repo_url: https://github.com/e2e-test/repo.git' \
    'board: e2e-test' \
    'repo_aliases: []' \
    'default_branch: main' \
    > /opt/hermes/projects/e2e-test/factory-project.yaml

# Dashboard plugin writes to /root/.hermes as state directory
RUN mkdir -p /root/.hermes

ENV PORT=7332
ENV BOARD_MCP_TOKENS=e2e-test-token:orchestrator
ENV BOARD_MCP_POLICY=/app/policy.yaml
ENV HERMES_PROJECTS_BASE=/opt/hermes/projects
ENV HERMES_KANBAN_API_URL=http://127.0.0.1:9119/api/plugins/kanban
ENV HERMES_KANBAN_API_ALLOW_REMOTE=1

EXPOSE 7332
EXPOSE 9119

COPY server/scripts/docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

HEALTHCHECK --interval=5s --timeout=3s --retries=10 \
  CMD node -e "fetch('http://127.0.0.1:7332/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

ENTRYPOINT ["/app/docker-entrypoint.sh"]
