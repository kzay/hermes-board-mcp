[Unit]
Description=Hermes Board MCP Server
After=network.target hermes-gateway.service
Wants=hermes-gateway.service

[Service]
Type=simple
User=root
EnvironmentFile=/etc/hermes/hermes-board-mcp.env
ExecStart=/usr/local/bin/hermes-board-mcp start
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Graceful shutdown
KillSignal=SIGTERM
TimeoutStopSec=10

# Reload tokens and policy on SIGHUP
ExecReload=/bin/kill -HUP $MAINPID

[Install]
WantedBy=multi-user.target
